# Blockchain Explorer API Keys
# Copy this file to .env and add your API keys

# Etherscan API key (for Ethereum mainnet and testnets)
# Get your free API key at: https://etherscan.io/apis
# Note: With Etherscan v2 API, this single key can access 60+ EVM chains!
# Use "chain <name> v2" in console to enable v2 API for supported chains
ETHERSCAN_API_KEY=

# Chain-specific API keys (for v1 API or non-Etherscan explorers)
# These are used when not using v2 API or for chains with their own explorers

# BSCScan API key (for Binance Smart Chain)
# Get your free API key at: https://bscscan.com/apis
BSCSCAN_API_KEY=

# PolygonScan API key (for Polygon/Matic)
# Get your free API key at: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=

# Arbiscan API key (for Arbitrum)
# Get your free API key at: https://arbiscan.io/apis
ARBISCAN_API_KEY=

# Snowtrace API key (for Avalanche)
# Get your free API key at: https://snowtrace.io/apis
SNOWTRACE_API_KEY=

# Other chain-specific API keys (check chains.yaml for the full list)
BASESCAN_API_KEY=
OPTIMISM_API_KEY=
FTMSCAN_API_KEY=
SCROLLSCAN_API_KEY=
GNOSISSCAN_API_KEY=

# Generic fallback API key for other explorers
SCAN_API_KEY=